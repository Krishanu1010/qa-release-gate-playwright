{
  "name": "qa-release-gate-playwright",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "Recruiter-ready QA portfolio: Playwright UI and API release gate for a demo storefront.",
  "scripts": {
    "test": "playwright test",
    "pretest": "node scripts/clean-test-reports.js",
    "test:ui": "playwright test --project=chromium",
    "pretest:ui": "node scripts/clean-test-reports.js",
    "test:api": "playwright test tests/api",
    "pretest:api": "node scripts/clean-test-reports.js",
    "test:smoke": "playwright test --grep @smoke",
    "pretest:smoke": "node scripts/clean-test-reports.js",
    "test:headed": "playwright test --headed",
    "pretest:headed": "node scripts/clean-test-reports.js",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "allure": "^3.22.1",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.9",
    "typescript": "^5.9.3"
  }
}
